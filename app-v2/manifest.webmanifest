{"name":"Ciskolateur","short_name":"Ciskolateur","description":"Ciskolateur is a fast, simple currency converter for GHS, USD, EUR, GBP, and CFA Francs. Convert currencies instantly, check exchange rates, and track when rates were last updated—all in one clean, mobile-friendly app. Ciskolateur | Know the rate. Make the conversion.","start_url":"/le-ciskolateur-infos/app-v2/","display":"standalone","background_color":"#121827","theme_color":"#e25706","lang":"en","scope":"/le-ciskolateur-infos/app-v2/","id":"/le-ciskolateur-infos/app-v2/","icons":[{"src":"assets/images/logos/logo.png","sizes":"1024x1024","purpose":"any"},{"src":"assets/images/logos/logo-dark.png","sizes":"1024x1024","purpose":"any"},{"src":"assets/images/logos/logo-light.png","sizes":"1024x1024","purpose":"any"}],"orientation":"portrait","screenshots":[{"sizes":"603x1281","src":"assets/images/screenshots/main-screen-cfa-cedis.png","form_factor":"narrow","label":"Ciskolateur main screen with a conversion of CFA 10000 to GHS giving 199."},{"sizes":"603x1281","src":"assets/images/screenshots/main-screen-cfa-usd.png","form_factor":"narrow","label":"Ciskolateur main screen with a conversion of CFA 150000 to USD giving 249.79."},{"sizes":"603x1281","src":"assets/images/screenshots/rates-screen.png","form_factor":"narrow","label":"Ciskolateur rates list screen shows available currencies with their rate and updated time."},{"sizes":"603x1281","src":"assets/images/screenshots/settings-screen.png","form_factor":"narrow","label":"Ciskolateur settings screen shows available setting parameters to customize the app according to your desire."}]}
